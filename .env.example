SWIGGY_MODE=fixture
SWIGGY_OAUTH_ENABLED=false
AI_PROVIDER=mock
AI_PROVIDER_ENDPOINT=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_PROVIDER_TIMEOUT_MS=4500
DATABASE_URL=
TOKEN_ENCRYPTION_KEY=
MOODISH_PUBLIC_URL=http://localhost:8787
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TEAMS_APP_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=common
GROUP_SESSION_SIGNING_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MOODISH_PORT=8786
MOODISH_WEB_PORT=8787

# Moodish for Teams: /teams.html. Slack installation uses the existing
# SLACK_CLIENT_ID, SLACK_CLIENT_SECRET, SLACK_SIGNING_SECRET and TOKEN_ENCRYPTION_KEY.
# Discord needs the existing CLIENT_ID/PUBLIC_KEY plus a bot token.
DISCORD_BOT_TOKEN=
# WhatsApp Cloud API credentials (never expose these in browser code).
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Public business phone number, digits only, for click-to-chat links.
WHATSAPP_PUBLIC_NUMBER=
# Pin the supported Graph version shown in your Meta application dashboard.
WHATSAPP_GRAPH_VERSION=
# Approved utility template with one body text parameter: the private meal URL.
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Random secret at least 32 characters. POST /api/teams/jobs from a scheduler.
TEAM_JOBS_SECRET=

# Enable the internal 30-second workspace worker after channel setup.
TEAM_JOBS_ENABLED=false
